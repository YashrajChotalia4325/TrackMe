# PostgreSQL connection string.
# Local (no Docker): run `npm run db:local` (Prisma's built-in Postgres) and paste the TCP URL it prints.
# Hosted (Vercel): use a Neon / Supabase / Prisma Postgres connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Neon: DATABASE_URL = pooled string ("-pooler" host), DIRECT_URL = direct string (used for migrations).
DIRECT_URL=""
# Use 1 with `prisma dev` (single-connection embedded Postgres); 5–10 for a real server.
DATABASE_POOL_MAX="1"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "false" to disable new sign-ups after creating your account.
ALLOW_SIGNUP="true"

# ── Optional integrations (see README → Integrations). Leave empty to hide them. ──
# Google Calendar + Gmail (read-only). Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub activity (read-only). Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Owner account created by `npm run db:seed` (local development only).
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD="change-me-at-least-8-chars"
