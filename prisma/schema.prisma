// ───────────────────────────── Personalization ─────────────────────────────

/// A kind of day (College day, Internship day, Weekend, Exam day) with its own rhythm.
model DayTemplate {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  color         String        @default("#FACC15")
  /// Default days of week (0=Sun … 6=Sat). A weekday maps to at most one template.
  daysOfWeek    Int[]         @default([])
  wakeMinute    Int
  sleepMinute   Int
  focusLimitMin Int
  taskLimit     Int
  /// Rest day: only essentials (fixed, high-priority, deadline-bound) are planned
  restDay       Boolean       @default(false)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  overrides     DayOverride[]

  @@index([userId])
}

/// Use a specific template on a specific date (e.g. "Exam day" on 25 Nov).
model DayOverride {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  templateId String
  template   DayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Personal time the scheduler never touches (family dinner, commute, prayer, no-screens hour).
model ProtectedBlock {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  daysOfWeek  Int[]
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// PREFER: place this category's work inside the window when possible.
/// AVOID: never auto-schedule this category inside the window.
model EnergyWindow {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = applies to all categories
  categoryKey CategoryKey?
  /// PREFER | AVOID
  kind        String
  daysOfWeek  Int[]
  startMinute Int
  endMinute   Int
  label       String?
  createdAt   DateTime     @default(now())

  @@index([userId])
}

model Habit {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  icon       String     @default("Check")
  color      String     @default("#22C55E")
  /// Days the habit is expected (0=Sun … 6=Sat)
  daysOfWeek Int[]      @default([0, 1, 2, 3, 4, 5, 6])
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  logs       HabitLog[]

  @@index([userId, active])
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String
  at      DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

// ───────────────────────────── Integrations ─────────────────────────────
// OAuth tokens live in Better Auth's `account` table (linked Google / GitHub accounts).

/// Per-provider sync state and preferences.
model Integration {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// GOOGLE_CALENDAR | GMAIL | GITHUB | CHATGPT | CLAUDE
  provider     String
  enabled      Boolean   @default(true)
  settings     Json?
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
}

/// A Gmail message classified as relevant (interview, assessment, offer, deadline…).
/// Only headers + Gmail's short snippet are stored — never the full body.
model EmailInsight {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailId       String
  threadId      String?
  fromAddress   String
  subject       String
  snippet       String?
  receivedAt    DateTime
  /// INTERVIEW | ASSESSMENT | OFFER | REJECTION | APPLICATION | COLLEGE | DEADLINE
  kind          String
  /// Company guessed from the sender
  company       String?
  /// Date mentioned in the email, if one could be parsed (YYYY-MM-DD)
  suggestedDate String?
  /// NEW | ACCEPTED | DISMISSED
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  @@unique([userId, gmailId])
  @@index([userId, status])
}

/// Daily GitHub contribution counts.
model GithubActivity {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String
  commits Int      @default(0)
  prs     Int      @default(0)
  reviews Int      @default(0)
  issues  Int      @default(0)
  repos   String[] @default([])

  @@unique([userId, date])
}

/// Daily AI-assistant usage imported from ChatGPT / Claude data exports.
model AiChatActivity {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CHATGPT | CLAUDE
  provider      String
  date          String
  conversations Int      @default(0)
  messages      Int      @default(0)
  /// Conversation titles (topics) for that day
  titles        String[] @default([])

  @@unique([userId, provider, date])
}
