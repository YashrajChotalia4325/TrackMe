  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  score     Float
  mode      SchedulingMode
  /// Weights snapshot used for this day â€” never recomputed from current settings
  weights   Json
  breakdown Json
  tasksDone Int            @default(0)
  tasksTotal Int           @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([userId, date])
}

model WeeklyReview {
